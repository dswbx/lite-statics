{
   "$schema": "./node_modules/wrangler/config-schema.json",
   "name": "static-host",
   "main": "src/worker/index.ts",
   "compatibility_date": "2026-07-08",
   "compatibility_flags": ["nodejs_compat"],
   "observability": {
      "enabled": true,
      "head_sampling_rate": 1
   },
   "assets": {
      "binding": "DASHBOARD",
      "directory": "./dist",
      "not_found_handling": "single-page-application",
      "run_worker_first": ["/api/*", "/s/*", "/auth/v1/*", "/rest/v1/*", "/storage/v1/*"]
   },
   "d1_databases": [
      {
         "binding": "DB",
         "database_name": "static-host-db",
         "migrations_dir": ".wrangler/migrations",
         "database_id": "0d14797c-c2af-4b73-a10b-c974617818c6"
      }
   ],
   "r2_buckets": [
      {
         "binding": "ASSET_BUCKET",
         "bucket_name": "static-host-assets"
      }
   ],
   "queues": {
      "producers": [
         {
            "binding": "VIEW_TRACKING_QUEUE",
            "queue": "static-host-view-tracking"
         }
      ],
      "consumers": [
         {
            "queue": "static-host-view-tracking",
            "max_batch_size": 100,
            "max_batch_timeout": 60
         }
      ]
   },
   "ratelimits": [
      {
         "name": "RATE_LIMIT",
         "namespace_id": "1001",
         "simple": { "limit": 60, "period": 60 }
      }
   ],
   "send_email": [{ "name": "EMAIL", "remote": true }],
   "vars": {
      "ACCESS_COOKIE_NAME": "static_host_access",
      "SITE_URL": "https://statics.supalite.run",
      "EMAIL_FROM_ADDRESS": "noreply@supalite.run",
      "EMAIL_FROM_NAME": "Statics"
   }
}
