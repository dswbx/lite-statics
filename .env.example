# Local secrets (gitignored). Keep `.dev.vars` identical so Wrangler/Vite pick them up.
# See README for Google Cloud Console setup (origins + /auth/v1/callback URIs).

JWT_SECRET=
COOKIE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local Vite origin. Overrides wrangler.jsonc so Google OAuth redirect_uri is
# http://localhost:5173/auth/v1/callback (not the lite default :54321).
SITE_URL=http://localhost:5173
